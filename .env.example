# ── Supabase ────────────────────────────────────────────────────────────────
# Find these in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-public-key>"
SUPABASE_SERVICE_ROLE_KEY="<service-role-secret-key>"   # server-side only, never expose to client

# ── NextAuth ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# ── Optional: Cloudinary for thumbnail hosting ──────────────────────────────
CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"

# ── Optional: Bunny.net CDN ──────────────────────────────────────────────────
BUNNY_STORAGE_KEY=""
BUNNY_STORAGE_ZONE=""

# ── Optional: Prisma (only needed if you want to run prisma migrate) ─────────
# DATABASE_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"
